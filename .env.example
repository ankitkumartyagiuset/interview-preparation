# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/interview_platform
DATABASE_URL_TEST=postgresql://postgres:postgres@db:5432/interview_platform_test

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-this-to-a-secure-random-key-min-32-characters
JWT_SECRET_KEY=change-this-to-another-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider Configuration
AI_PROVIDER=mock
# Options: openai, anthropic, mock

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=2000

# Storage Configuration
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=["pdf","doc","docx"]

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME=Interview Platform
APP_VERSION=1.0.0
API_PREFIX=/api

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Interview Settings
MAX_INTERVIEW_DURATION_MINUTES=120
MIN_QUESTIONS_PER_INTERVIEW=5
MAX_QUESTIONS_PER_INTERVIEW=30
DEFAULT_INTERVIEW_DIFFICULTY=intermediate

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@interviewplatform.com

# S3/Object Storage (Optional - for production)
USE_S3_STORAGE=false
S3_BUCKET_NAME=interview-platform
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT_URL=https://s3.amazonaws.com
